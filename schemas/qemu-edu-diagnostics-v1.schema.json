        "name": {"const": "yocto-qemu-edu-lab"},
        "version": {"oneOf": [{"$ref": "#/$defs/project_version"}, {"type": "null"}]},
        "revision": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
