{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsparc.github.io/yocto-qemu-edu-lab/schemas/qemu-edu-diagnostics-v1.schema.json",
  "title": "QEMU EDU diagnostics version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "command", "result", "project", "lab", "checks", "data"],
  "properties": {
    "kind": {"const": "qemu-edu-diagnostics"},
    "schema_version": {"const": 1},
    "command": {"enum": ["status", "doctor", "inspect", "evidence"]},
    "result": {"enum": ["pass", "warning", "fail", "unavailable"]},
    "project": {"$ref": "#/$defs/project"},
    "lab": {"$ref": "#/$defs/lab"},
    "checks": {"type": "array"},
    "data": {"type": "object"}
  },
  "oneOf": [
    {"$ref": "#/$defs/status_command"},
    {"$ref": "#/$defs/doctor_command"},
    {"$ref": "#/$defs/inspect_command"},
    {"$ref": "#/$defs/evidence_command"}
  ],
  "allOf": [
    {"if": {"properties": {"result": {"const": "pass"}}, "required": ["result"]}, "then": {"properties": {"checks": {"items": {"properties": {"status": {"const": "pass"}}, "required": ["status"]}}}}},
    {"if": {"properties": {"result": {"const": "fail"}}, "required": ["result"]}, "then": {"properties": {"checks": {"contains": {"properties": {"status": {"const": "fail"}}, "required": ["status"]}, "minContains": 1}}}},
    {"if": {"properties": {"result": {"const": "unavailable"}}, "required": ["result"]}, "then": {"properties": {"checks": {"not": {"contains": {"properties": {"status": {"const": "fail"}}, "required": ["status"]}}, "contains": {"properties": {"status": {"const": "unavailable"}, "required": {"const": true}}, "required": ["status", "required"]}, "minContains": 1}}}},
    {"if": {"properties": {"result": {"const": "warning"}}, "required": ["result"]}, "then": {"properties": {"checks": {"not": {"contains": {"anyOf": [{"properties": {"status": {"const": "fail"}}, "required": ["status"]}, {"properties": {"status": {"const": "unavailable"}, "required": {"const": true}}, "required": ["status", "required"]}]}}, "contains": {"anyOf": [{"properties": {"status": {"const": "warning"}}, "required": ["status"]}, {"properties": {"status": {"const": "unavailable"}, "required": {"const": false}}, "required": ["status", "required"]}]}, "minContains": 1}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "short_string": {"type": "string", "minLength": 1, "maxLength": 4096},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "revision", "dirty"],
      "properties": {
        "name": {"const": "yocto-qemu-edu-lab"},
        "version": {"oneOf": [{"type": "string", "pattern": "^0\\.6\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$", "maxLength": 4096}, {"type": "null"}]},
        "revision": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "lab": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "index_sha256", "manifest_sha256"],
      "properties": {
        "id": {"enum": ["pci-x86-64", "platform-arm64"]},
        "index_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "required", "summary"],
      "properties": {
        "id": {"type": "string", "maxLength": 64},
        "status": {"enum": ["pass", "warning", "fail", "unavailable"]},
        "required": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]}, "then": {"properties": {"summary": {"enum": ["Project version is valid.", "Repository identity is valid.", "Maintenance task state is valid.", "Source lock is valid.", "Lab catalog is valid.", "Selected lab is valid.", "Repository worktree is clean.", "Required Git executable is available.", "Required SSH executable is available.", "BitBake checkout matches the source lock.", "OpenEmbedded Core checkout matches the source lock.", "Meta-Yocto checkout matches the source lock.", "Declared local configuration file is present.", "Declared layer configuration file is present.", "Selected evidence file is readable and bounded.", "Evidence document is valid.", "Evidence records a clean passing suite.", "Evidence inputs match the selected project inputs.", "Evidence subject matches the current revision."]}}}},
        {"if": {"properties": {"status": {"const": "warning"}}, "required": ["status"]}, "then": {"properties": {"summary": {"enum": ["Repository worktree has uncommitted changes.", "Historical PCI evidence does not record lab catalog bindings.", "Evidence describes a different clean revision."]}}}},
        {"if": {"properties": {"status": {"const": "fail"}}, "required": ["status"]}, "then": {"properties": {"summary": {"enum": ["Project version is invalid.", "Repository identity is invalid.", "Maintenance task state is invalid.", "Source lock is invalid.", "Lab catalog is invalid.", "Selected lab is inconsistent.", "Git executable does not meet the diagnostic contract.", "SSH executable does not meet the diagnostic contract.", "BitBake checkout differs from the source lock.", "OpenEmbedded Core checkout differs from the source lock.", "Meta-Yocto checkout differs from the source lock.", "Declared local configuration path is invalid.", "Declared layer configuration path is invalid.", "Selected evidence path violates the file contract.", "Evidence document is invalid.", "Evidence does not record a clean passing suite.", "Evidence inputs differ from the selected project inputs."]}}}},
        {"if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]}, "then": {"properties": {"summary": {"enum": ["Project version is unavailable.", "Repository identity is unavailable.", "Maintenance task state is unavailable.", "Source lock is unavailable.", "Lab catalog could not be evaluated.", "Selected lab could not be evaluated.", "Repository cleanliness could not be evaluated.", "Required Git executable is unavailable.", "Required SSH executable is unavailable.", "BitBake checkout is unavailable.", "OpenEmbedded Core checkout is unavailable.", "Meta-Yocto checkout is unavailable.", "Declared local configuration file is unavailable.", "Declared layer configuration file is unavailable.", "Selected evidence file is unavailable.", "Evidence document could not be evaluated.", "Evidence result could not be evaluated.", "Evidence inputs could not be evaluated.", "Evidence subject match could not be evaluated."]}}}}
      ]
    },
    "project_version_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "project.version"}, "required": {"const": true}, "summary": {"enum": ["Project version is valid.", "Project version is invalid.", "Project version is unavailable."]}}},
    "repository_git_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "repository.git"}, "required": {"const": true}, "summary": {"enum": ["Repository identity is valid.", "Repository identity is invalid.", "Repository identity is unavailable."]}}},
    "workflow_task_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "workflow.task"}, "required": {"const": true}, "summary": {"enum": ["Maintenance task state is valid.", "Maintenance task state is invalid.", "Maintenance task state is unavailable."]}}},
    "source_lock_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "inputs.source-lock"}, "required": {"const": true}, "summary": {"enum": ["Source lock is valid.", "Source lock is invalid.", "Source lock is unavailable."]}}},
    "lab_catalog_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "inputs.lab-catalog"}, "required": {"const": true}, "summary": {"enum": ["Lab catalog is valid.", "Lab catalog is invalid.", "Lab catalog could not be evaluated."]}}},
    "lab_selection_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "lab.selection"}, "required": {"const": true}, "summary": {"enum": ["Selected lab is valid.", "Selected lab is inconsistent.", "Selected lab could not be evaluated."]}}},
    "repository_clean_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "repository.clean"}, "required": {"const": false}, "summary": {"enum": ["Repository worktree is clean.", "Repository worktree has uncommitted changes.", "Repository cleanliness could not be evaluated."]}}},
    "tool_git_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "tool.git"}, "required": {"const": true}, "summary": {"enum": ["Required Git executable is available.", "Git executable does not meet the diagnostic contract.", "Required Git executable is unavailable."]}}},
    "tool_ssh_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "tool.ssh"}, "required": {"const": true}, "summary": {"enum": ["Required SSH executable is available.", "SSH executable does not meet the diagnostic contract.", "Required SSH executable is unavailable."]}}},
    "source_bitbake_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "source.bitbake"}, "required": {"const": true}, "summary": {"enum": ["BitBake checkout matches the source lock.", "BitBake checkout differs from the source lock.", "BitBake checkout is unavailable."]}}},
    "source_oe_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "source.openembedded-core"}, "required": {"const": true}, "summary": {"enum": ["OpenEmbedded Core checkout matches the source lock.", "OpenEmbedded Core checkout differs from the source lock.", "OpenEmbedded Core checkout is unavailable."]}}},
    "source_yocto_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "source.meta-yocto"}, "required": {"const": true}, "summary": {"enum": ["Meta-Yocto checkout matches the source lock.", "Meta-Yocto checkout differs from the source lock.", "Meta-Yocto checkout is unavailable."]}}},
    "local_conf_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "build.local-conf"}, "required": {"const": true}, "summary": {"enum": ["Declared local configuration file is present.", "Declared local configuration path is invalid.", "Declared local configuration file is unavailable."]}}},
    "bblayers_conf_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "build.bblayers-conf"}, "required": {"const": true}, "summary": {"enum": ["Declared layer configuration file is present.", "Declared layer configuration path is invalid.", "Declared layer configuration file is unavailable."]}}},
    "evidence_file_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "evidence.file"}, "required": {"const": true}, "summary": {"enum": ["Selected evidence file is readable and bounded.", "Selected evidence path violates the file contract.", "Selected evidence file is unavailable."]}}},
    "evidence_document_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "evidence.document"}, "required": {"const": true}, "summary": {"enum": ["Evidence document is valid.", "Evidence document is invalid.", "Evidence document could not be evaluated."]}}},
    "evidence_result_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "evidence.result"}, "required": {"const": true}, "summary": {"enum": ["Evidence records a clean passing suite.", "Evidence does not record a clean passing suite.", "Evidence result could not be evaluated."]}}},
    "evidence_inputs_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "evidence.inputs"}, "required": {"const": true}, "summary": {"enum": ["Evidence inputs match the selected project inputs.", "Historical PCI evidence does not record lab catalog bindings.", "Evidence inputs differ from the selected project inputs.", "Evidence inputs could not be evaluated."]}}},
    "evidence_subject_check": {"$ref": "#/$defs/check", "properties": {"id": {"const": "evidence.subject"}, "required": {"const": false}, "summary": {"enum": ["Evidence subject matches the current revision.", "Evidence describes a different clean revision.", "Evidence subject match could not be evaluated."]}}},
    "active_task": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"type": "string", "pattern": "^A[0-9]{3,}$"}, "status": {"const": "In Progress"}}}
      ]
    },
    "evidence_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "project", "build", "result", "summary", "native_input_sha256", "source_lock_sha256", "file_sha256"],
      "properties": {
        "kind": {"enum": ["qemu-edu-runtime", "qemu-edu-platform-runtime"]},
        "schema_version": {"type": "integer", "minimum": 1, "maximum": 3},
        "project": {"type": "object", "additionalProperties": false, "required": ["version", "revision", "dirty"], "properties": {"version": {"$ref": "#/$defs/short_string"}, "revision": {"$ref": "#/$defs/sha1"}, "dirty": {"type": "boolean"}}},
        "build": {"type": "object", "additionalProperties": false, "required": ["machine", "image", "testimage_exit_code"], "properties": {"machine": {"$ref": "#/$defs/short_string"}, "image": {"$ref": "#/$defs/short_string"}, "testimage_exit_code": {"type": "integer", "minimum": 0, "maximum": 255}}},
        "result": {"enum": ["passed", "failed"]},
        "summary": {"type": "object", "additionalProperties": false, "required": ["total", "passed", "failed", "skipped", "errors"], "properties": {"total": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}}},
        "native_input_sha256": {"$ref": "#/$defs/sha256"},
        "source_lock_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "qemu-edu-runtime"}, "schema_version": {"enum": [1, 2, 3]}}},
        {"properties": {"kind": {"const": "qemu-edu-platform-runtime"}, "schema_version": {"const": 1}}}
      ]
    },
    "status_data": {
      "type": "object", "additionalProperties": false, "required": ["active_task", "source_lock", "selected_lab"],
      "properties": {
        "active_task": {"$ref": "#/$defs/active_task"},
        "source_lock": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["sha256", "yocto_version", "yocto_series"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "yocto_version": {"$ref": "#/$defs/short_string"}, "yocto_series": {"$ref": "#/$defs/short_string"}}}]},
        "selected_lab": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["build_dir", "machine", "image", "driver", "evidence_profile"], "properties": {"build_dir": {"$ref": "#/$defs/short_string"}, "machine": {"$ref": "#/$defs/short_string"}, "image": {"$ref": "#/$defs/short_string"}, "driver": {"$ref": "#/$defs/short_string"}, "evidence_profile": {"$ref": "#/$defs/short_string"}}}]}
      }
    },
    "doctor_data": {"type": "object", "additionalProperties": false, "required": ["active_task", "evidence"], "properties": {"active_task": {"$ref": "#/$defs/active_task"}, "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_summary"}]}}},
    "inspect_data": {
      "type": "object", "additionalProperties": false, "required": ["release", "sources", "build", "emulator", "runtime", "source_lock_sha256"],
      "properties": {
        "release": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["project_version", "yocto_version", "yocto_series"], "properties": {"project_version": {"type": "string", "pattern": "^0\\.6\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$", "maxLength": 4096}, "yocto_version": {"$ref": "#/$defs/short_string"}, "yocto_series": {"$ref": "#/$defs/short_string"}}}]},
        "sources": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/source_bitbake"}, {"$ref": "#/$defs/source_oe"}, {"$ref": "#/$defs/source_yocto"}], "items": false}]},
        "build": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["build_dir", "machine", "image", "driver", "layers"], "properties": {"build_dir": {"$ref": "#/$defs/short_string"}, "machine": {"$ref": "#/$defs/short_string"}, "image": {"$ref": "#/$defs/short_string"}, "driver": {"$ref": "#/$defs/short_string"}, "layers": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/short_string"}}}}]},
        "emulator": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["profile", "system_binary"], "properties": {"profile": {"$ref": "#/$defs/short_string"}, "system_binary": {"$ref": "#/$defs/short_string"}}}]},
        "runtime": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["suite", "evidence_profile", "guest_contract_version", "evidence_schema_version"], "properties": {"suite": {"$ref": "#/$defs/short_string"}, "evidence_profile": {"$ref": "#/$defs/short_string"}, "guest_contract_version": {"type": "integer", "minimum": 1, "maximum": 3}, "evidence_schema_version": {"type": "integer", "minimum": 1, "maximum": 3}}}]},
        "source_lock_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "url", "branch_ref", "release_ref", "commit"], "properties": {"id": {"enum": ["bitbake", "openembedded-core", "meta-yocto"]}, "url": {"type": "string", "pattern": "^https://", "maxLength": 4096}, "branch_ref": {"$ref": "#/$defs/short_string"}, "release_ref": {"$ref": "#/$defs/short_string"}, "commit": {"$ref": "#/$defs/sha1"}}},
    "source_bitbake": {"$ref": "#/$defs/source", "properties": {"id": {"const": "bitbake"}}},
    "source_oe": {"$ref": "#/$defs/source", "properties": {"id": {"const": "openembedded-core"}}},
    "source_yocto": {"$ref": "#/$defs/source", "properties": {"id": {"const": "meta-yocto"}}},
    "evidence_data": {
      "type": "object", "additionalProperties": false, "required": ["evidence", "inputs", "subject_matches_head"],
      "properties": {
        "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_summary"}]},
        "inputs": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["lab_binding", "lab_index_sha256", "lab_manifest_sha256"],
              "properties": {
                "lab_binding": {"enum": ["bound", "not-recorded"]},
                "lab_index_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
                "lab_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
              },
              "oneOf": [
                {"properties": {"lab_binding": {"const": "bound"}, "lab_index_sha256": {"$ref": "#/$defs/sha256"}, "lab_manifest_sha256": {"$ref": "#/$defs/sha256"}}},
                {"properties": {"lab_binding": {"const": "not-recorded"}, "lab_index_sha256": {"type": "null"}, "lab_manifest_sha256": {"type": "null"}}}
              ]
            }
          ]
        },
        "subject_matches_head": {"type": ["boolean", "null"]}
      }
    },
    "status_command": {"properties": {"command": {"const": "status"}, "checks": {"type": "array", "minItems": 7, "maxItems": 7, "prefixItems": [{"$ref": "#/$defs/project_version_check"}, {"$ref": "#/$defs/repository_git_check"}, {"$ref": "#/$defs/workflow_task_check"}, {"$ref": "#/$defs/source_lock_check"}, {"$ref": "#/$defs/lab_catalog_check"}, {"$ref": "#/$defs/lab_selection_check"}, {"$ref": "#/$defs/repository_clean_check"}], "items": false}, "data": {"$ref": "#/$defs/status_data"}}},
    "doctor_command": {"properties": {"command": {"const": "doctor"}, "checks": {"type": "array", "minItems": 18, "maxItems": 18, "prefixItems": [{"$ref": "#/$defs/project_version_check"}, {"$ref": "#/$defs/repository_git_check"}, {"$ref": "#/$defs/workflow_task_check"}, {"$ref": "#/$defs/source_lock_check"}, {"$ref": "#/$defs/lab_catalog_check"}, {"$ref": "#/$defs/lab_selection_check"}, {"$ref": "#/$defs/tool_git_check"}, {"$ref": "#/$defs/tool_ssh_check"}, {"$ref": "#/$defs/source_bitbake_check"}, {"$ref": "#/$defs/source_oe_check"}, {"$ref": "#/$defs/source_yocto_check"}, {"$ref": "#/$defs/local_conf_check"}, {"$ref": "#/$defs/bblayers_conf_check"}, {"$ref": "#/$defs/evidence_file_check"}, {"$ref": "#/$defs/evidence_document_check"}, {"$ref": "#/$defs/evidence_result_check"}, {"$ref": "#/$defs/evidence_inputs_check"}, {"$ref": "#/$defs/evidence_subject_check"}], "items": false}, "data": {"$ref": "#/$defs/doctor_data"}}},
    "inspect_command": {"properties": {"command": {"const": "inspect"}, "checks": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"$ref": "#/$defs/project_version_check"}, {"$ref": "#/$defs/repository_git_check"}, {"$ref": "#/$defs/source_lock_check"}, {"$ref": "#/$defs/lab_catalog_check"}, {"$ref": "#/$defs/lab_selection_check"}], "items": false}, "data": {"$ref": "#/$defs/inspect_data"}}},
    "evidence_command": {"properties": {"command": {"const": "evidence"}, "checks": {"type": "array", "minItems": 10, "maxItems": 10, "prefixItems": [{"$ref": "#/$defs/project_version_check"}, {"$ref": "#/$defs/repository_git_check"}, {"$ref": "#/$defs/source_lock_check"}, {"$ref": "#/$defs/lab_catalog_check"}, {"$ref": "#/$defs/lab_selection_check"}, {"$ref": "#/$defs/evidence_file_check"}, {"$ref": "#/$defs/evidence_document_check"}, {"$ref": "#/$defs/evidence_result_check"}, {"$ref": "#/$defs/evidence_inputs_check"}, {"$ref": "#/$defs/evidence_subject_check"}], "items": false}, "data": {"$ref": "#/$defs/evidence_data"}}}
  }
}
