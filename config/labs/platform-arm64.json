{
  "schema_version": 3,
  "id": "platform-arm64",
  "description": "Device Tree and platform-driver lab on the ARM64 QEMU virt machine",
  "build": {
    "build_dir": "build-platform-arm64",
    "distro": "poky",
    "machine": "qemu-edu-platform-arm64",
    "driver_target": "qemu-edu-platform-driver",
    "targets": [
      "qemu-edu-image"
    ],
    "layers": [
      "layers/openembedded-core/meta",
      "layers/meta-yocto/meta-poky",
      "meta-qemu-edu"
    ]
  },
  "emulator": {
    "preflight_profile": "qemu-edu-platform-v1",
    "system_binary": "qemu-system-aarch64"
  },
  "runtime": {
    "suite": "qemu_edu_platform",
    "evidence_profile": "platform-v1",
    "evidence_filename": "qemu-edu-platform-runtime-v1.json",
    "guest_contract_version": 1,
    "evidence_schema_version": 1
  },
  "supply_chain": {
    "evidence_profile": "spdx3-image-v1",
    "evidence_filename": "qemu-edu-spdx-image-v1.json",
    "required_packages": [
      {
        "name": "kernel-module-qemu-edu-platform-6.18.24-yocto-standard",
        "declared_license": "GPL-2.0-only"
      },
      {
        "name": "qemu-edu-platform-driver",
        "declared_license": "GPL-2.0-only"
      },
      {
        "name": "qemu-edu-platform-tools",
        "declared_license": "MIT"
      }
    ],
    "forbidden_packages": [
      "kernel-module-qemu-edu-6.18.24-yocto-standard",
      "qemu-edu-driver",
      "qemu-edu-sdk-sample",
      "qemu-edu-tools"
    ]
  },
  "development": {
    "profile": "direct-esdk-devtool-v1",
    "build_dir": "build-sdk-platform-arm64",
    "recipe": "qemu-edu-sdk-sample",
    "source_dir": "learner-source/qemu-edu-sdk-sample",
    "ide": "none",
    "guest_binary": "/usr/bin/qemu-edu-sdk-sample",
    "evidence_filename": "qemu-edu-sdk-evidence-v1.json",
    "evidence_schema_version": 1
  }
}
