{
  "schema_version": 2,
  "id": "pci-x86-64",
  "description": "QEMU EDU PCI lab on the x86-64 classic PC machine",
  "build": {
    "build_dir": "build",
    "distro": "poky",
    "machine": "qemu-edu-x86-64",
    "driver_target": "qemu-edu-driver",
    "targets": [
      "qemu-edu-image"
    ],
    "layers": [
      "layers/openembedded-core/meta",
      "layers/meta-yocto/meta-poky",
      "meta-qemu-edu"
    ]
  },
  "emulator": {
    "preflight_profile": "qemu-edu-pci-v1",
    "system_binary": "qemu-system-x86_64"
  },
  "runtime": {
    "suite": "qemu_edu",
    "evidence_profile": "pci-v3",
    "evidence_filename": "qemu-edu-runtime-v3.json",
    "guest_contract_version": 3,
    "evidence_schema_version": 3
  },
  "supply_chain": {
    "evidence_profile": "spdx3-image-v1",
    "evidence_filename": "qemu-edu-spdx-image-v1.json",
    "required_packages": [
      {
        "name": "kernel-module-qemu-edu-6.18.24-yocto-standard",
        "declared_license": "GPL-2.0-only"
      },
      {
        "name": "qemu-edu-driver",
        "declared_license": "GPL-2.0-only"
      },
      {
        "name": "qemu-edu-tools",
        "declared_license": "MIT"
      }
    ],
    "forbidden_packages": [
      "kernel-module-qemu-edu-platform-6.18.24-yocto-standard",
      "qemu-edu-platform-driver",
      "qemu-edu-platform-tools"
    ]
  }
}
