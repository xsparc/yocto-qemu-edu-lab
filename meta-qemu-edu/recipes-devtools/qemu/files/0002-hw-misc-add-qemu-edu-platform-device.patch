diff --git a/hw/misc/qemu_edu_platform.c b/hw/misc/qemu_edu_platform.c
new file mode 100644
index 0000000..0874926
--- /dev/null
+++ b/hw/misc/qemu_edu_platform.c
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * QEMU educational platform device
+ *
+ * Copyright (c) 2026 Yocto QEMU EDU learning project contributors
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/qemu_edu_platform.h"
+#include "hw/irq.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define QEMU_EDU_PLATFORM_ID 0x0100a64e
+#define QEMU_EDU_PLATFORM_ID_REG 0x00
+#define QEMU_EDU_PLATFORM_SCRATCH_REG 0x04
+#define QEMU_EDU_PLATFORM_IRQ_STATUS_REG 0x20
+#define QEMU_EDU_PLATFORM_IRQ_RAISE_REG 0x60
+#define QEMU_EDU_PLATFORM_IRQ_ACK_REG 0x64
+
+typedef struct QemuEduPlatformState QemuEduPlatformState;
+DECLARE_INSTANCE_CHECKER(QemuEduPlatformState, QEMU_EDU_PLATFORM,
+                         TYPE_QEMU_EDU_PLATFORM)
+
+struct QemuEduPlatformState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    qemu_irq irq;
+    uint32_t scratch;
+    uint32_t irq_status;
+};
+
+static void qemu_edu_platform_update_irq(QemuEduPlatformState *s)
+{
+    qemu_set_irq(s->irq, s->irq_status != 0);
+}
+
+static uint64_t qemu_edu_platform_read(void *opaque, hwaddr offset,
+                                       unsigned int size)
+{
+    QemuEduPlatformState *s = opaque;
+
+    switch (offset) {
+    case QEMU_EDU_PLATFORM_ID_REG:
+        return QEMU_EDU_PLATFORM_ID;
+    case QEMU_EDU_PLATFORM_SCRATCH_REG:
+        return s->scratch;
+    case QEMU_EDU_PLATFORM_IRQ_STATUS_REG:
+        return s->irq_status;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: invalid read at 0x%" HWADDR_PRIx "\n",
+                      TYPE_QEMU_EDU_PLATFORM, offset);
+        return UINT32_MAX;
+    }
+}
+
+static void qemu_edu_platform_write(void *opaque, hwaddr offset,
+                                    uint64_t value, unsigned int size)
+{
+    QemuEduPlatformState *s = opaque;
+    uint32_t value32 = value;
+
+    switch (offset) {
+    case QEMU_EDU_PLATFORM_SCRATCH_REG:
+        s->scratch = value32;
+        break;
+    case QEMU_EDU_PLATFORM_IRQ_RAISE_REG:
+        s->irq_status |= value32;
+        qemu_edu_platform_update_irq(s);
+        break;
+    case QEMU_EDU_PLATFORM_IRQ_ACK_REG:
+        s->irq_status &= ~value32;
+        qemu_edu_platform_update_irq(s);
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: invalid write at 0x%" HWADDR_PRIx "\n",
+                      TYPE_QEMU_EDU_PLATFORM, offset);
+        break;
+    }
+}
+
+static const MemoryRegionOps qemu_edu_platform_ops = {
+    .read = qemu_edu_platform_read,
+    .write = qemu_edu_platform_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void qemu_edu_platform_reset(DeviceState *dev)
+{
+    QemuEduPlatformState *s = QEMU_EDU_PLATFORM(dev);
+
+    s->scratch = 0;
+    s->irq_status = 0;
+    qemu_edu_platform_update_irq(s);
+}
+
+static void qemu_edu_platform_init(Object *obj)
+{
+    QemuEduPlatformState *s = QEMU_EDU_PLATFORM(obj);
+
+    memory_region_init_io(&s->mmio, obj, &qemu_edu_platform_ops, s,
+                          TYPE_QEMU_EDU_PLATFORM,
+                          QEMU_EDU_PLATFORM_MMIO_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mmio);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+}
+
+static void qemu_edu_platform_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, qemu_edu_platform_reset);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo qemu_edu_platform_info = {
+    .name = TYPE_QEMU_EDU_PLATFORM,
+    .parent = TYPE_DYNAMIC_SYS_BUS_DEVICE,
+    .instance_size = sizeof(QemuEduPlatformState),
+    .instance_init = qemu_edu_platform_init,
+    .class_init = qemu_edu_platform_class_init,
+};
+
+static void qemu_edu_platform_register_types(void)
+{
+    type_register_static(&qemu_edu_platform_info);
+}
+
+type_init(qemu_edu_platform_register_types)
