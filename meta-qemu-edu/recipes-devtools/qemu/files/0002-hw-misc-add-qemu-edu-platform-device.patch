diff --git a/hw/core/sysbus-fdt.c b/hw/core/sysbus-fdt.c
index 59f1d17..8bba0d5 100644
--- a/hw/core/sysbus-fdt.c
+++ b/hw/core/sysbus-fdt.c
@@ -36,6 +36,7 @@
 #include "hw/display/ramfb.h"
 #include "hw/uefi/var-service-api.h"
 #include "hw/arm/fdt.h"
+#include "hw/misc/qemu_edu_platform.h"
 
 /*
  * internal struct that contains the information to create dynamic
@@ -123,6 +124,30 @@ static int no_fdt_node(SysBusDevice *sbdev, void *opaque)
     return 0;
 }
 
+static int add_qemu_edu_platform_fdt_node(SysBusDevice *sbdev, void *opaque)
+{
+    PlatformBusFDTData *data = opaque;
+    PlatformBusDevice *pbus = data->pbus;
+    hwaddr mmio_base = platform_bus_get_mmio_addr(pbus, sbdev, 0);
+    int irq = platform_bus_get_irqn(pbus, sbdev, 0);
+    char *nodename;
+
+    assert(mmio_base != (hwaddr)-1);
+    assert(irq >= 0);
+    nodename = g_strdup_printf("%s/qemu-edu@%" PRIx64,
+                               data->pbus_node_name, mmio_base);
+    qemu_fdt_add_subnode(data->fdt, nodename);
+    qemu_fdt_setprop_string(data->fdt, nodename, "compatible",
+                            "qemu,edu-platform");
+    qemu_fdt_setprop_cells(data->fdt, nodename, "reg",
+                           mmio_base, QEMU_EDU_PLATFORM_MMIO_SIZE);
+    qemu_fdt_setprop_cells(data->fdt, nodename, "interrupts",
+                           GIC_FDT_IRQ_TYPE_SPI, data->irq_start + irq,
+                           GIC_FDT_IRQ_FLAGS_LEVEL_HI);
+    g_free(nodename);
+    return 0;
+}
+
 /* Device type based matching */
 static bool type_match(SysBusDevice *sbdev, const BindingEntry *entry)
 {
@@ -140,6 +165,7 @@ static const BindingEntry bindings[] = {
     TYPE_BINDING(TYPE_ARM_SMMUV3, no_fdt_node),
     TYPE_BINDING(TYPE_RAMFB_DEVICE, no_fdt_node),
     TYPE_BINDING(TYPE_UEFI_VARS_SYSBUS, add_uefi_vars_node),
+    TYPE_BINDING(TYPE_QEMU_EDU_PLATFORM, add_qemu_edu_platform_fdt_node),
     TYPE_BINDING("", NULL), /* last element */
 };
 
